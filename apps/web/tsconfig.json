{
  "extends": "@triumph/typescript-config/base.json",
  "include": [
    "src",
    ".next/types/**/*.ts"
  ],
  "compilerOptions": {
    "outDir": "dist",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "incremental": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ]
  }
}
