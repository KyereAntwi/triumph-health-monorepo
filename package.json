{
  "name": "triumph-health-monorepo",
  "version": "1.0.0",
  "description": "A monorepo for the Triumph Health platform",
  "main": "index.js",
  "license": "ISC",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:facility-app": "turbo run dev --filter=facility-app",
    "dev:tenant-portal": "turbo run dev --filter=tenant-portal",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "build:facility-app": "turbo run build --filter=facility-app",
    "build:tenant-portal": "turbo run build --filter=tenant-portal",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.2.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "turbo": "^2.9.14",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "tailwind-merge": "^3.6.0"
  },
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
